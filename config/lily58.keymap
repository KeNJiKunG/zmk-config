#define ZMK_POINTING_DEFAULT_MOVE_VAL 400  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    /* Override mouse move acceleration: 2s to reach max speed */
    mmv {
        time-to-max-speed-ms = <2000>;
    };

    behaviors {
        /* Tab: Ctrl -> Shift+Tab ; Shift -> Ctrl+Tab ; Shift+Ctrl -> Shift+Ctrol ; else Tab  (left mods only) */
        tab_no_ctrl: tab_no_ctrl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&kp LC(TAB)>;
            mods = <(MOD_LSFT)>;
        };
        tab_on_ctrl: tab_on_ctrl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(TAB)>, <&kp LC(LS(TAB))>;
            mods = <(MOD_LSFT)>;
        };
        tab_swap: tab_swap {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&tab_no_ctrl>, <&tab_on_ctrl>;
            mods = <(MOD_LCTL)>;
        };
        /* Esc: Ctrl -> Shift+Esc ; Shift -> Ctrl+Esc ; Shift+Ctrl -> Shift+Ctrl+Esc ; else Esc  (left mods only) */
        esc_no_ctrl: esc_no_ctrl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp LC(ESC)>;
            mods = <(MOD_LSFT)>;
        };
        esc_on_ctrl: esc_on_ctrl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(ESC)>, <&kp LC(LS(ESC))>;
            mods = <(MOD_LSFT)>;
        };
        esc_swap: esc_swap {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&esc_no_ctrl>, <&esc_on_ctrl>;
            mods = <(MOD_LCTL)>;
        };
        /* Gaming exit: LCtrl+LShift+BkSp -> tog 0 (return to base); plain BkSp -> BSPC */
        gamining_bksp_ctrl: gamining_bksp_ctrl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&to 0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        gamining_bksp: gamining_bksp {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&gamining_bksp_ctrl>;
            mods = <(MOD_LCTL)>;
        };

        /* BT profile: hold 3s = clear all bonds, tap = select profile n
         * The macro wraps &bt BT_SEL, forwarding macro param1 → param2 (profile index).
         * hold-tap forwards param1 → &bt (BT_CLR_CMD), param2 → bt_sel_macro.
         */
        bt_sel_macro: bt_sel_macro {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2>, <&bt BT_SEL_CMD 0>;
        };
        bt_ht: bt_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <3000>;
            bindings = <&bt>, <&bt_sel_macro>;
        };
        /* Left Shift: hold = Shift, tap = Shift (single), double-tap = Caps Lock */
        td_caps: td_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
        };
        /* Mouse hold-tap: quick tap = click, hold >2s = drag (held while key held) */
        lclk_ht: lclk_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <2000>;
            bindings = <&mkp &mkp>;
        };
        rclk_ht: rclk_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <2000>;
            bindings = <&mkp &mkp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

//  =============================  DEFAULT LAYER  =============================
//
//  Silakka54 physical layout (54 keys = 12×4 rows + 6 thumbs):
//
        default_layer {
            label = "Base";
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BSPC  |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | [   |
// | CTRL  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |t=ENT,h=RCTRL|
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |                   |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                     | ALT  | t=Spc,h=GUI | LOWER|         | RAISE| t=Spc,h=GUI | ALT  |
            bindings = <
&esc_swap &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                       &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC
&tab_swap &kp Q  &kp W  &kp E  &kp R  &kp T                        &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT
&kp LCTRL    &kp A  &kp S  &kp D  &kp F  &kp G                        &kp H  &kp J  &kp K  &kp L  &kp SEMI &mt RCTRL RET
&td_caps    &kp Z  &kp X  &kp C  &kp V  &kp B  &trans  &trans        &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                          &kp LALT &mt LGUI SPACE &lt 1 SPACE  &trans  &trans  &lt 2 SPACE  &mt RGUI SPACE &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

//  =============================  LOWER LAYER  =============================
//
//  Left = D-PAD + BT + symbols, Right = NUMPAD + scroll
//
        lower_layer {
            label = "Lower";
// D-PAD                                      NUMPAD
// | BTCLR | BT1 | BT2 | BT3  | BT4  | BT5 |                   |  `   |      | Equal  | Slash  |  Star  |    |
// |       |     | PGDN| UP   | PGUP |  -_  |                  |  =+   |  7   |  8    |  9    | MINUS  |     |
// |       |     |LEFT | DOWN |RIGHT |  {  |                   |   }  |  4   |  5    |  6    | PLUS   |       |
// | STUDI |     |HOME |      | END  |  \  |                   |  '   |  1   |  2    |  3    | ENTER  |       |
//                     |      |      |      |                  |      |  0   |   .    |
            bindings = <
&out OUT_TOG &bt_ht 0 0 &bt_ht 0 1 &bt_ht 0 2 &bt_ht 0 3 &bt_ht 0 4                   &kp GRAVE &trans &kp KP_EQUAL &kp KP_SLASH &kp KP_ASTERISK &trans
&trans     &trans       &kp PG_DN    &kp UP       &kp PG_UP     &kp MINUS                              &kp EQUAL &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_MINUS &trans
&trans     &trans       &kp LEFT     &kp DOWN     &kp RIGHT     &kp LBKT                               &kp RBKT  &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_PLUS  &trans
&studio_unlock     &trans       &kp HOME     &trans       &kp END       &kp BSLH  &trans  &trans               &kp SQT &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_ENTER &trans
                                                  &trans        &trans    &trans   &trans  &trans         &trans    &kp KP_N0 &kp KP_DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

//  =============================  RAISE LAYER  =============================
//
//  Left = FUNC (F1–F12), Right = MOUSE
//
        raise_layer {
            label = "Raise";
//                FUNC                                            MOUSE
// |       |     |     |      |      |      |                   |      |  MB4 |MMIDDLE|  MB5  |   -_    |    =+    |
// |       |  F1 |  F2 |  F3  |  F4  |  PSCN    |                   | MSCRDN  | MCL  |  MUP  | MCR   | [{] |   ]}     |
// |       |  F5 |  F6 |  F7  |  F8  |      |                   |  MSCRUP |MLEFT | MDOWN |MRIGHT | '" |   '"   |
// | STDUI |  F9 | F10 | F11  | F12  |      |                   |   |  MSR  |       |   MSL  |        |        |
//                     | MSPD-| MSPD+|      |                   |      |      |        |
            bindings = <
&trans &trans &trans &trans  &trans  &trans                                              &trans  &mkp MB4 &mkp MCLK &mkp MB5  &kp MINUS &kp EQUAL
&trans &kp F1  &kp F2 &kp F3 &kp F4  &kp PSCRN                                             &msc SCRL_DOWN  &lclk_ht LCLK LCLK &mmv MOVE_UP &rclk_ht RCLK RCLK  &kp LBKT  &kp RBKT
&trans &kp F5  &kp F6 &kp F7 &kp F8  &trans                                              &msc SCRL_UP  &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &kp SQT &kp SQT
&studio_unlock  &kp F9  &kp F10 &kp F11 &kp F12 &trans &trans  &trans                               &trans  &msc SCRL_RIGHT &trans  &msc SCRL_LEFT   &trans    &trans
                          &trans &trans &trans &trans  &trans  &trans                       &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

//  =============================  ADJUST LAYER  =============================
//
//  Activated when LOWER + RAISE layer keys are held together.
//  (ZMK maps 'both held' to a single layer; press order is not distinguished.)
//
        adjust_layer {
            label = "Adjust";
// | STUIO |     |     |      |      |      |                   |      |      |       |       |       |        |
// |       | F13 | F14 | F15  |  F16 |      |                   |      |      |       |       |       |        |
// |       | F17 | F18 | F19  |  F20 |      |                   |      |      |       |       |       |        |
// |       | F21 | F22 | F23  |  F24 |      |                   |      |      |       |       |       |        |
//                     |      |      |      |                   |      |      |       |
            bindings = <
&studio_unlock &tog 4 &trans &trans &trans &trans                                            &trans &trans &trans &trans &trans &trans
&trans &kp F13 &kp F14 &kp F15 &kp F16 &trans                                            &trans &trans &trans &trans &trans &trans
&trans &kp F17 &kp F18 &kp F19 &kp F20 &trans                                            &trans &trans &trans &trans &trans &trans
&trans &kp F21 &kp F22 &kp F23 &kp F24 &trans &trans  &trans                               &trans &trans &trans &trans &trans &trans
                          &trans &trans &trans &trans  &trans  &trans                       &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

//  =============================  GAMING LAYER  =============================
//
//  Clean WASD layout — no mod-morphs, no tap-dances, no layer toggles.
//  Activated via LOWER+RAISE+1 (tog 4). Press ESC to return to DEFAULT.
//
        gaming_layer {
            label = "Gaming";
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BSPC  |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | [{   |
// | CTRL  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   | ENTER |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |                   |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                     | ALT  | LGUI |SPACE |                   | SPACE| RGUI | ALT  |
            bindings = <
&kp ESC     &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                       &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &gamining_bksp
&kp TAB     &kp Q  &kp W  &kp E  &kp R  &kp T                        &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT
&kp LCTRL   &kp A  &kp S  &kp D  &kp F  &kp G                        &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp ENTER
&kp LSHFT   &kp Z  &kp X  &kp C  &kp V  &kp B  &trans  &trans        &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                          &kp LALT &kp LGUI &kp SPACE  &trans  &trans    &kp SPACE &kp RGUI &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
 
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_on_both {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
