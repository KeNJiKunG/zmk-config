#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        /* Tab: Ctrl -> Shift+Tab ; Shift -> Ctrl+Tab ; else Tab  (left mods only) */
        tab_on_shift: tab_on_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&kp LC(TAB)>;
            mods = <(MOD_LSFT)>;
        };
        tab_swap: tab_swap {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&tab_on_shift>, <&kp LS(TAB)>;
            mods = <(MOD_LCTL)>;
        };
        /* Esc: Ctrl -> Shift+Esc ; Shift -> Ctrl+Esc ; else Esc  (left mods only) */
        esc_on_shift: esc_on_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp LC(ESC)>;
            mods = <(MOD_LSFT)>;
        };
        esc_swap: esc_swap {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&esc_on_shift>, <&kp LS(ESC)>;
            mods = <(MOD_LCTL)>;
        };
        /* BT profile: hold 3s = clear all bonds, tap = select profile n
         * The macro wraps &bt BT_SEL, forwarding macro param1 → param2 (profile index).
         * hold-tap forwards param1 → &bt (BT_CLR_CMD), param2 → bt_sel_macro.
         */
        bt_sel_macro: bt_sel_macro {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2>, <&bt BT_SEL_CMD 0>;
        };
        bt_ht: bt_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <3000>;
            bindings = <&bt>, <&bt_sel_macro>;
        };
        /* Left Shift: single tap = Shift, double tap = Caps Lock */
        td_caps: td_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

//  =============================  DEFAULT LAYER  =============================
//
//  Silakka54 physical layout (54 keys = 12×4 rows + 6 thumbs):
//
        default_layer {
            label = "DEFAULT";
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BSPC  |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | DEL   |
// | CTRL  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |t=ENT,h=RCTRL|
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |                   |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                     | ALT  | t=Spc,h=GUI | LOWER|         | RAISE| t=Spc,h=GUI | ALT  |
            bindings = <
&esc_swap &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                       &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC
&tab_swap &kp Q  &kp W  &kp E  &kp R  &kp T                        &kp Y  &kp U  &kp I  &kp O  &kp P  &kp DEL
&kp LCTRL    &kp A  &kp S  &kp D  &kp F  &kp G                        &kp H  &kp J  &kp K  &kp L  &kp SEMI &mt RCTRL RET
&td_caps    &kp Z  &kp X  &kp C  &kp V  &kp B  &trans  &trans        &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                          &kp LALT &mt LGUI SPACE &lt 1 SPACE  &trans  &trans  &lt 2 SPACE  &mt RGUI SPACE &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

//  =============================  LOWER LAYER  =============================
//
//  Left = D-PAD + BT + symbols, Right = NUMPAD + scroll
//
        lower_layer {
            label = "LOWER";
// D-PAD                                      NUMPAD
// | BTCLR | BT1 | BT2 | BT3  | BT4  | BT5 |                   |  `   |      | Equal  | Slash  |  Star  |    |
// |       |     | PGDN| UP   | PGUP |  {  |                   |  }   |  7   |  8    |  9    | MINUS  |     |
// |       |     |LEFT | DOWN |RIGHT |  '  |                   |  -_   |  4   |  5    |  6    | PLUS   |       |
// | STUDI |     |HOME |      | END  |  \  |                   |  =+   |  1   |  2    |  3    | ENTER  |       |
//                     |      |      |      |                  |      |  0   |   .    |
            bindings = <
&out OUT_TOG &bt_ht 0 0 &bt_ht 0 1 &bt_ht 0 2 &bt_ht 0 3 &bt_ht 0 4                   &kp GRAVE &trans &kp KP_EQUAL &kp KP_SLASH &kp KP_ASTERISK &trans
&trans     &trans       &kp PG_DN    &kp UP       &kp PG_UP     &kp LBKT                              &kp RBKT &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_MINUS &trans
&trans     &trans       &kp LEFT     &kp DOWN     &kp RIGHT     &kp SQT                               &kp MINUS  &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_PLUS  &trans
&studio_unlock     &trans       &kp HOME     &trans       &kp END       &kp BSLH  &trans  &trans               &kp EQUAL &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_ENTER &trans
                                                  &trans        &trans    &trans0   &trans  &trans         &trans    &kp KP_N0 &kp KP_DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

//  =============================  RAISE LAYER  =============================
//
//  Left = FUNC (F1–F12), Right = MOUSE
//
        raise_layer {
            label = "RAISE";
//                FUNC                                            MOUSE
// |       |     |     |      |      |      |                   |      |      |MMIDDLE|       |       |        |
// |       |  F1 |  F2 |  F3  |  F4  |  PSCN    |                   | MB3  | MCL  |  MUP  |  MCR  |MSCRUP  |        |
// |       |  F5 |  F6 |  F7  |  F8  |      |                   | MB4  |MLEFT | MDOWN |MRIGHT |MSCRDN  |        |
// |       |  F9 | F10 | F11  | F12  |      |                   | MB5  |  MSL    |       |  MSR     |        |        |
//                     | MSPD-| MSPD+|      |                   |      |      |        |
            bindings = <
&trans &trans &trans &trans  &trans  &trans                                              &trans  &trans &mkp MCLK &trans &trans &trans
&trans &kp F1  &kp F2 &kp F3 &kp F4  &kp PSCRN                                             &mkp MB3  &mkp LCLK &mmv MOVE_UP &mkp RCLK  &msc SCRL_UP    &trans
&trans &kp F5  &kp F6 &kp F7 &kp F8  &trans                                              &mkp MB4  &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_DOWN &trans
&trans &kp F9  &kp F10 &kp F11 &kp F12 &trans &trans  &trans                               &mkp MB5  &msc SCRL_LEFT &trans &msc SCRL_RIGHT   &trans    &trans
                          &trans &trans &trans &trans  &trans  &trans                       &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

//  =============================  ADJUST LAYER  =============================
//
//  Activated when LOWER + RAISE layer keys are held together.
//  (ZMK maps 'both held' to a single layer; press order is not distinguished.)
//
        adjust_layer {
            label = "ADJUST";
// | STUIO |     |     |      |      |      |                   |      |      |       |       |       |        |
// |       | F13 | F14 | F15  |  F16 |      |                   |      |      |       |       |       |        |
// |       | F17 | F18 | F19  |  F20 |      |                   |      |      |       |       |       |        |
// |       | F21 | F22 | F23  |  F24 |      |                   |      |      |       |       |       |        |
//                     |      |      |      |                   |      |      |       |
            bindings = <
&studio_unlock &trans &trans &trans &trans &trans                                            &trans &trans &trans &trans &trans &trans
&trans &kp F13 &kp F14 &kp F15 &kp F16 &trans                                            &trans &trans &trans &trans &trans &trans
&trans &kp F17 &kp F18 &kp F19 &kp F20 &trans                                            &trans &trans &trans &trans &trans &trans
&trans &kp F21 &kp F22 &kp F23 &kp F24 &trans &trans &trans                             &trans &trans &trans &trans &trans &trans
                                  &trans &trans &trans &trans &trans                 &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_on_both {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
